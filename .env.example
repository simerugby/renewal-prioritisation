# Optional. The app is fully functional without this — scores, evidence, rankings
# and suggested actions are all computed in code. Without a key the AI account
# brief falls back to a rule-based version and says so on screen.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4.1-nano, which is the model the supplied key is
# scoped to. The feature is one call per account on demand, capped at 600 output
# tokens and cached per account. Change this to point at a different model; no
# code change is needed.
OPENAI_MODEL=gpt-4.1-nano
