# Optional. The app is fully functional without this — scores, evidence, rankings
# and suggested actions are all computed in code. Without a key the AI account
# brief falls back to a rule-based version and says so on screen.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini, chosen for cost: the feature is one call per
# account on demand, capped at 400 output tokens and cached per account.
OPENAI_MODEL=gpt-4o-mini
